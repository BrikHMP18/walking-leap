#!/bin/bash
# real/panel/run [--fake]: the control panel in the hand driver's env (see server.py). WL_PYTHON:
# a Python with numpy and the driver; by default the driver's conda env. ROS's paths kept out.
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
py="${WL_PYTHON:-$HOME/miniconda3/envs/dexhw/bin/python}"
exec env -u PYTHONPATH PYTHONNOUSERSITE=1 "$py" "$here/server.py" "$@"
