#!/bin/bash
# real/wl ...: Walking Leap's control loop (see wl.py), in the loop's own Python: real/.venv
# (made once by real/setup), or WL_PYTHON. ROS's Python paths are kept out.
here="$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")"
py="${WL_PYTHON:-$here/.venv/bin/python}"
if [ ! -x "$py" ]; then
  echo "no Python for the loop at $py: run real/setup once (or set WL_PYTHON)" >&2
  exit 1
fi
exec env -u PYTHONPATH PYTHONNOUSERSITE=1 "$py" "$here/wl.py" "$@"
